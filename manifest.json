{
  "manifest_version": 3,
  "name": "Free Screen Recorder",
  "version": "4.0.1",
  "description": "Grabador de pantalla/pestana local, sin limite de duracion ni nube.",
  "action": {
    "default_title": "Grabar pantalla",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "identity",
    "offscreen",
    "power",
    "downloads",
    "tabCapture",
    "scripting",
    "tabs",
    "desktopCapture"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "<all_urls>"
  ],
  "key": ""
}